# Copy this file to .env at the repository root. Never commit .env.
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed to send credentialed requests.
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# Runtime AI provider.
# - mock (default): deterministic, network-free case generator. No key required.
# - openai-compatible: calls an OpenAI-compatible /chat/completions endpoint.
#   The adapter sends a strict JSON-schema prompt, parses JSON content, and
#   validates the result before anything is published. No provider is assumed.
AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=8000

# Media mode.
# - static (default): image exhibits use the approved fictional SVG diagram.
# - none: image exhibits keep their written description and interpretation only.
# No live image or video provider is implemented.
MEDIA_PROVIDER=static

# Security values. Generate real random secrets locally, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_chars
SESSION_TTL_HOURS=24
GUEST_COOKIE_TTL_DAYS=30
TRUST_PROXY=0

# Rate limits and generation safeguards.
CASE_GENERATION_LIMIT_PER_HOUR=5
HINT_RATE_LIMIT_PER_HOUR=30
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX=300
MAX_SCENARIO_LENGTH=2000
MAX_GENERATION_ATTEMPTS=3
HINT_LIMIT=3
REQUEST_BODY_LIMIT=32kb
LOG_LEVEL=info

# Optional frontend override. Leave unset for same-origin /api in development
# and in the Vite preview build. Set it only when the API is on another origin:
# VITE_API_BASE_URL=https://api.example.test/api
